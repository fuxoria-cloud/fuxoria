# 狐岚云：复制为 .env 后填写；密钥用 openssl rand -hex 32 生成。
NODE_ENV=development
PORT=3301
HOST=127.0.0.1
# API仅信任此列表中的代理；本机Nuxt使用loopback，容器网络在Compose中显式覆盖。
TRUST_PROXY_CIDRS=loopback
PUBLIC_ORIGIN=http://127.0.0.1:3300
API_ORIGIN=http://127.0.0.1:3301
DATABASE_URL=postgresql://yunzou:yunzou_local@127.0.0.1:55480/yunzou
REDIS_URL=redis://127.0.0.1:6389
# Docker Compose使用的独立随机密码；npm run setup会自动生成。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_TTL_SECONDS=86400
# 与数据库分开保管，用于签署资金与操作审计记录。
AUDIT_KEY=replace-with-random-64-hex-characters
# 双重验证使用独立AES-256密钥；不要与审计密钥共用，备份时一起保管。
TOTP_KEY=
# 实名资料独立AES-GCM密钥；首次setup自动生成。私有文件随部署数据卷备份。
CERTIFICATION_KEY=
VERIFICATION_KEY=
# 资源凭据与敏感操作参数独立加密，API与Go使用相同值，随加密数据保留原密钥。
RESOURCE_KEY=
# 本机留空时写用户数据目录；Compose固定使用/var/lib/yunzou部署卷。
FILE_STORAGE_DIR=
CERTIFICATION_STORAGE_DIR=
# 邮件/短信发送配置指向源码外的私有JSON；未配置的渠道不提供发码。
MESSAGE_SENDER_CONFIG=
# 微信开放平台网站应用；两项均填写后显示微信扫码，回调见docs/oauth.md。
OAUTH_WECHAT_APP_ID=
OAUTH_WECHAT_APP_SECRET=
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=
NUXT_PUBLIC_API_BASE=/api/v1
# Nuxt前面还有Nginx/CDN时，填写其可信CIDR；空值仅使用真实socket来源。
NUXT_TRUST_PROXY_CIDRS=
